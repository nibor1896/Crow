   "show_at_install": true,
   "text_file": null,
   "_text_file": "The text is the License.txt every NVIDIA wheel carries in its dist-info (59,262 B, the same bytes in all five); CrowSetup writes it to text_dest from the wheel, like the libraries. It is no entry of files: nvidia_files are not fetched from a repo at a commit.",
   "text_dest": "${INSTALL}/licenses/NVIDIA-CUDA-EULA.txt",
   "summary": "Crow ships no NVIDIA file: CrowSetup downloads NVRTC, cuBLAS and the CUDA runtime from NVIDIA's own wheels on PyPI, so you receive them from NVIDIA under its CUDA Toolkit End User License Agreement."
  },
  "msvc-v14-runtime": {
